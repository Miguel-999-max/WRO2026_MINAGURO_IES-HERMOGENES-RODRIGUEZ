flowchart TD
    A([Power on: relay + power supplies]) --> B["hardware.py<br/>Initializes servos, TFmini x3, Husky 2,<br/>color sensor, magnetometer, spotlight"]
    B --> C["main.py<br/>Waits for start button<br/>(blinking LEDs)"]
    C --> D["Reference heading<br/>(compass reading on press)"]
    D --> E{"Front TFmini<br/>&lt; 30 cm?"}

    E -- "Yes: we are in the<br/>parking lot" --> F["Measure right and<br/>left sides"]
    F --> G{"Right &gt;<br/>left?"}
    G -- Yes --> H["MISSION 3 (CW)<br/>ORANGE line<br/>headings of the 4 lanes"]
    G -- No --> I["MISSION 4 (CCW)<br/>BLUE line<br/>headings of the 4 lanes"]
    H --> H1["desaparca_mision_3()<br/>reverse by distance +<br/>forward-right by time"]
    I --> I1["desaparca_mision_4()<br/>reverse by distance +<br/>forward-left by time +<br/>reverse-right by time"]
    H1 --> J[["Obstacle Challenge<br/>3 laps = 12 lines<br/>(see diagram 2)"]]
    I1 --> J

    E -- "No: open challenge" --> K["Move straight with front TFmini<br/>turned right<br/>and left side sensor"]
    K --> L{"Gap &gt; 100 cm<br/>on either side?"}
    L -- "On the right" --> M["MISSION 1 (CW)"]
    L -- "On the left" --> N["MISSION 2 (CCW)"]
    M --> R["Exit lane heading<br/>= heading when button was pressed"]
    N --> R
    R --> O[["Open Challenge<br/>3 laps = 12 lines<br/>(see diagram 3)"]]

    J --> Z([Stopped in the exit zone<br/>160 cm in M3 / 110 cm in M4])
    O --> Z2([Stopped 160 cm from the back wall])

    X["Any error (exception)"] -.-> Y(["parada_de_emergencia()<br/>motors stopped, error.log,<br/>blinking red LED"])
